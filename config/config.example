# qs-bgselector configuration
#
# Copy to  ${XDG_CONFIG_HOME:-~/.config}/qs-bgselector/config
# This is a plain shell file. Every line is optional; the values shown are the
# defaults. Environment variables of the same name override this file.

# ---- library ---------------------------------------------------------------
# Folder with your wallpapers (searched recursively).
# Default: first existing of ~/Pictures/Wallpapers, ~/Pictures/wallpapers,
#          ~/Wallpapers, ~/wallpapers, ~/Pictures
#BGSEL_WALL_DIR="$HOME/Pictures/Wallpapers"

# Limit how deep subfolders are scanned (empty = unlimited, 1 = top level only).
#BGSEL_MAX_DEPTH=""

# ---- applying a wallpaper --------------------------------------------------
# auto | feh | nitrogen | xwallpaper | hsetroot | awww | swww | hyprpaper | swaybg | custom
# On X11, auto picks feh, nitrogen, xwallpaper, or hsetroot.
# On Wayland, auto prefers a running daemon (awww/swww/hyprpaper), then swaybg.
#BGSEL_BACKEND="auto"

# Run your own command instead of a built-in backend. The picked image is in
# $BGSEL_WALLPAPER. Setting this makes the backend "custom" when it is "auto".
#BGSEL_SET_CMD='feh --bg-fill "$BGSEL_WALLPAPER"'

# awww / swww transition for Wayland (any value `awww img -t` accepts, or "none").
# Note: Native X11 backends (feh, nitrogen, etc.) set the root pixmap directly
# and do not use animated transitions.
#BGSEL_TRANSITION="fade"
#BGSEL_TRANSITION_DURATION="1.5"
#BGSEL_TRANSITION_FPS="60"
#BGSEL_TRANSITION_BEZIER=".4,0,.2,1"

# Where the "current wallpaper" symlink is kept (used for the check mark in the
# picker and for --restore).
#BGSEL_CURRENT_LINK="$HOME/.cache/current-wallpaper"

# ---- theming ---------------------------------------------------------------
# auto (matugen if installed) | matugen | wal | none
#BGSEL_THEME="auto"
#BGSEL_MATUGEN_ARGS="--source-color-index 0 -t scheme-smart"

# Seconds to wait between starting the transition and running the theme step.
#BGSEL_THEME_DELAY="0.4"

# Any command to run last. The image is in $BGSEL_WALLPAPER.
#BGSEL_POST_CMD='notify-send "Wallpaper changed" "$BGSEL_WALLPAPER"'

# ---- looks -----------------------------------------------------------------
#BGSEL_ACCENT="#84d6c3"
#BGSEL_TICK="#00382f"
#BGSEL_TEXT="#dee4e1"
#BGSEL_TEXT_MUTED="#bec9c5"
#BGSEL_FONT="JetBrains Mono"

# ---- backdrop image (behind the carousel) ----------------------------------
# auto | current | none | /path/to/image.jpg
# auto: On X11, shows your current wallpaper in the background with a dark tint;
#       on Wayland, uses the desktop background scrim.
# current: Always displays the current wallpaper in the background.
# none: Pure translucent/solid dark scrim without a wallpaper image.
# /path/to/image.jpg: Use any specific custom image as the backdrop.
#BGSEL_BACKDROP="auto"

# ---- cache -----------------------------------------------------------------
#BGSEL_CACHE_DIR="$HOME/.cache/qs-bgselector"
