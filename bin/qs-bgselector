#!/usr/bin/env bash
# qs-bgselector — keyboard-driven wallpaper carousel for Quickshell.
#
# Builds/refreshes a thumbnail cache, then opens the picker. Picking a
# wallpaper runs scripts/apply.sh (wallpaper backend + optional theming).
#
# Run `qs-bgselector --help` for usage, `qs-bgselector --doctor` to check
# your setup.

set -u

PROG="qs-bgselector"
VERSION="1.0.0"

THUMB_W=800
THUMB_H=600
THUMB_Q=80

# ---- helpers ---------------------------------------------------------------
log()    { printf '%s: %s\n' "$PROG" "$*" >&2; }
have()   { command -v "$1" >/dev/null 2>&1; }
notify() { have notify-send && notify-send -a "$PROG" "$@" 2>/dev/null; return 0; }
die()    { log "error: $*"; notify -u critical "$PROG" "$*"; exit 1; }

usage() {
    cat <<EOF
$PROG $VERSION — wallpaper carousel for Quickshell

Usage: $PROG [options]

  (no options)        open the picker
  -d, --dir PATH      use PATH as the wallpaper directory
  -c, --config FILE   use FILE instead of the default config
      --restore       re-apply the last picked wallpaper (for login/autostart)
      --random        apply a random wallpaper (never the current one)
      --prepare       build/refresh the thumbnail cache and exit
      --rebuild       throw the thumbnail cache away first
      --doctor        check dependencies and configuration
  -h, --help          show this help
  -v, --version       show the version

Config file: \${XDG_CONFIG_HOME:-~/.config}/$PROG/config
Any BGSEL_* variable can also be set in the environment (wins over the file).
EOF
}

# ---- locate our files (git checkout, --dev install or normal install) ------
self="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(dirname -- "$(dirname -- "$self")")"
share=""
for cand in "${BGSEL_SHARE_DIR:-}" "$root" "$root/share/$PROG"; do
    if [ -n "$cand" ] && [ -f "$cand/qml/shell.qml" ]; then share="$cand"; break; fi
done
[ -n "$share" ] || { log "error: cannot find qml/shell.qml (looked in $root and $root/share/$PROG)"; exit 1; }

# ---- command line ----------------------------------------------------------
mode=ui
rebuild=0
cli_dir=""
cli_config=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)    usage; exit 0 ;;
        -v|--version) echo "$PROG $VERSION"; exit 0 ;;
        --doctor)     mode=doctor ;;
        --restore)    mode=restore ;;
        --random)     mode=random ;;
        --prepare)    mode=prepare ;;
        --rebuild)    rebuild=1 ;;
        -d|--dir)     [ $# -ge 2 ] || die "$1 needs a path"; cli_dir="$2"; shift ;;
        -c|--config)  [ $# -ge 2 ] || die "$1 needs a file"; cli_config="$2"; shift ;;
        *)            usage >&2; die "unknown option: $1" ;;
    esac
    shift
done

# ---- configuration: defaults < config file < environment < command line ------
config_vars=(
    BGSEL_WALL_DIR BGSEL_MAX_DEPTH BGSEL_CACHE_DIR BGSEL_CURRENT_LINK
    BGSEL_BACKEND BGSEL_SET_CMD
    BGSEL_TRANSITION BGSEL_TRANSITION_DURATION BGSEL_TRANSITION_FPS BGSEL_TRANSITION_BEZIER
    BGSEL_THEME BGSEL_MATUGEN_ARGS BGSEL_THEME_DELAY BGSEL_POST_CMD
    BGSEL_ACCENT BGSEL_TICK BGSEL_TEXT BGSEL_TEXT_MUTED BGSEL_FONT
)

CONFIG_FILE="${cli_config:-${BGSEL_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/$PROG/config}}"

declare -A env_override=()
for v in "${config_vars[@]}"; do
    if [ -n "${!v+x}" ]; then env_override[$v]="${!v}"; fi
done
# Colors generated by matugen (see README). Loaded first so the config file can
# still override them.
COLORS_FILE="${BGSEL_COLORS_FILE:-$(dirname -- "$CONFIG_FILE")/colors}"
if [ -f "$COLORS_FILE" ]; then
    # shellcheck source=/dev/null
    . "$COLORS_FILE" 2>/dev/null || log "warning: could not read colors file: $COLORS_FILE"
fi
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    . "$CONFIG_FILE" || die "could not read config: $CONFIG_FILE"
elif [ -n "$cli_config" ] || [ -n "${BGSEL_CONFIG:-}" ]; then
    die "config file not found: $CONFIG_FILE"
fi
for v in "${!env_override[@]}"; do printf -v "$v" '%s' "${env_override[$v]}"; done
[ -n "$cli_dir" ] && BGSEL_WALL_DIR="$cli_dir"

cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
: "${BGSEL_CACHE_DIR:=$cache_home/$PROG}"
: "${BGSEL_CURRENT_LINK:=$cache_home/current-wallpaper}"
: "${BGSEL_MAX_DEPTH:=}"
: "${BGSEL_BACKEND:=auto}"
: "${BGSEL_SET_CMD:=}"
: "${BGSEL_TRANSITION:=fade}"
: "${BGSEL_TRANSITION_DURATION:=1.5}"
: "${BGSEL_TRANSITION_FPS:=60}"
: "${BGSEL_TRANSITION_BEZIER:=.4,0,.2,1}"
: "${BGSEL_THEME:=auto}"
: "${BGSEL_MATUGEN_ARGS:=--source-color-index 0 -t scheme-smart}"
: "${BGSEL_THEME_DELAY:=0.4}"
: "${BGSEL_POST_CMD:=}"
: "${BGSEL_ACCENT:=#84d6c3}"
: "${BGSEL_TICK:=#00382f}"
: "${BGSEL_TEXT:=#dee4e1}"
: "${BGSEL_TEXT_MUTED:=#bec9c5}"
: "${BGSEL_FONT:=JetBrains Mono}"

# Wallpaper directory: first existing common location unless configured.
if [ -z "${BGSEL_WALL_DIR:-}" ]; then
    BGSEL_WALL_DIR="$HOME/Pictures/Wallpapers"
    for d in "$HOME/Pictures/Wallpapers" "$HOME/Pictures/wallpapers" \
             "$HOME/Wallpapers" "$HOME/wallpapers" "$HOME/Pictures"; do
        if [ -d "$d" ]; then BGSEL_WALL_DIR="$d"; break; fi
    done
fi

# "~" is not expanded inside quotes in a sourced config file.
for v in BGSEL_WALL_DIR BGSEL_CACHE_DIR BGSEL_CURRENT_LINK; do
    printf -v "$v" '%s' "${!v/#\~/$HOME}"
done
BGSEL_WALL_DIR="${BGSEL_WALL_DIR%/}"
[ -n "$BGSEL_WALL_DIR" ] || BGSEL_WALL_DIR="/"

# Per-directory cache, so switching directories never thrashes thumbnails.
dir_id="$(printf '%s' "$BGSEL_WALL_DIR" | md5sum | cut -c1-10)"
CACHE_ROOT="$BGSEL_CACHE_DIR"
DATA_DIR="$CACHE_ROOT/$dir_id"
CACHE_LIST="$DATA_DIR/.list"
CACHE_SIG="$DATA_DIR/.sig"

export "${config_vars[@]}"

APPLY="$share/scripts/apply.sh"

# ---- tool detection --------------------------------------------------------
find_imagemagick() {
    if have magick; then BGSEL_IM=magick
    elif have convert; then BGSEL_IM=convert   # ImageMagick 6 (Debian/Ubuntu)
    else return 1; fi
}

find_quickshell() {
    if have quickshell; then QS_BIN=quickshell
    elif have qs; then QS_BIN=qs
    else return 1; fi
}

# ---- wallpaper listing / thumbnail cache -----------------------------------
# Prints "path<TAB>mtime<TAB>size", sorted by path.
list_wallpapers() {
    local depth=()
    [ -n "$BGSEL_MAX_DEPTH" ] && depth=(-maxdepth "$BGSEL_MAX_DEPTH")
    find -H "$BGSEL_WALL_DIR" "${depth[@]}" -type f \
        ! -path '*[[:cntrl:]]*' \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \
           -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.tif' -o -iname '*.tiff' \
           -o -iname '*.avif' \) \
        -printf '%p\t%T@\t%s\n' 2>/dev/null | LC_ALL=C sort -t $'\t' -k1,1
}

# Thumbnail file name for a wallpaper, returned in $REPLY (no subshell).
# '_' -> '_u' and '/' -> '_s' keeps the mapping one-to-one, so a/b_c.jpg and
# a_b/c.jpg can never share a thumbnail. Very long paths fall back to a hash.
thumb_name() {
    local rel="${1#"$BGSEL_WALL_DIR"/}"
    rel="${rel%.*}"
    local n="${rel//_/_u}"
    n="${n//\//_s}"
    if [ ${#n} -gt 200 ]; then
        n="h_$(printf '%s' "$1" | md5sum | cut -d' ' -f1)"
    fi
    REPLY="$n.jpg"
}

# Runs in parallel workers (exported). Reads the image from stdin so that file
# names containing [ ] are never mistaken for ImageMagick frame specifiers.
generate_thumbnail() {
    local img="$1" out="$2"
    local tmp="${out%.jpg}.tmp.$$.jpg"
    # -define jpeg:size must come BEFORE the input to hint the decoder to
    # decode at reduced size; -delete 1--1 keeps only the first frame (gifs).
    if "$BGSEL_IM" -define "jpeg:size=$((THUMB_W * 2))x$((THUMB_H * 2))" - \
        -delete 1--1 -auto-orient -filter Triangle -strip \
        -thumbnail "${THUMB_W}x${THUMB_H}^" -gravity center \
        -extent "${THUMB_W}x${THUMB_H}" -quality "$THUMB_Q" +repage \
        "$tmp" < "$img" 2>/dev/null; then
        mv -f "$tmp" "$out" && touch -r "$img" "$out" && echo 1 >> "$OK_FILE"
    else
        rm -f "$tmp"
        echo 1 >> "$FAIL_FILE"
    fi
}

build_cache() {
    find_imagemagick || die "ImageMagick not found (need 'magick' or 'convert'). Run: $PROG --doctor"
    mkdir -p "$DATA_DIR" || die "cannot create cache directory: $DATA_DIR"

    if [ "$rebuild" = 1 ]; then
        rm -f "$DATA_DIR"/*.jpg "$CACHE_SIG" "$CACHE_LIST"
    fi
    # New thumbnail settings -> throw the old ones away once
    local scheme="v4-${THUMB_W}x${THUMB_H}-q${THUMB_Q}"
    if [ "$(cat "$DATA_DIR/.scheme" 2>/dev/null)" != "$scheme" ]; then
        rm -f "$DATA_DIR"/*.jpg "$CACHE_SIG" "$CACHE_LIST"
        printf '%s\n' "$scheme" > "$DATA_DIR/.scheme"
    fi

    local listing sig
    listing=$(mktemp) || die "mktemp failed"
    list_wallpapers > "$listing"
    sig=$({ echo "$scheme"; cat "$listing"; } | md5sum | cut -d' ' -f1)

    # Fast path: nothing was added, removed or changed since the last run
    if [ -f "$CACHE_LIST" ] && [ "$(cat "$CACHE_SIG" 2>/dev/null)" = "$sig" ]; then
        rm -f "$listing"
        echo "Cache up to date"
        return 0
    fi

    # Work out which thumbnails are missing or out of date. Thumbnails get their
    # source file's timestamp, so a replaced wallpaper (even with an older
    # timestamp) no longer matches and is regenerated.
    local to_generate img cache_file
    local imgs=() names=()
    to_generate=$(mktemp) || die "mktemp failed"
    while IFS=$'\t' read -r img _; do
        [ -n "$img" ] || continue
        thumb_name "$img"
        imgs+=("$img")
        names+=("$REPLY")
        cache_file="$DATA_DIR/$REPLY"
        if [ ! -f "$cache_file" ] || [ "$img" -nt "$cache_file" ] || [ "$cache_file" -nt "$img" ]; then
            printf '%s\0%s\0' "$img" "$cache_file" >> "$to_generate"
        fi
    done < "$listing"
    rm -f "$listing"

    # Generate thumbnails in parallel on all cores
    OK_FILE=$(mktemp); FAIL_FILE=$(mktemp)
    export OK_FILE FAIL_FILE BGSEL_IM THUMB_W THUMB_H THUMB_Q
    export -f generate_thumbnail
    if [ -s "$to_generate" ]; then
        # shellcheck disable=SC2016  # $1/$2 are meant to expand inside the worker
        xargs -0 -n 2 -P "$(nproc 2>/dev/null || echo 4)" \
            bash -c 'generate_thumbnail "$1" "$2"' _ < "$to_generate"
    fi
    local ok fail
    ok=$(wc -l < "$OK_FILE"); fail=$(wc -l < "$FAIL_FILE")
    rm -f "$to_generate" "$OK_FILE" "$FAIL_FILE"
    if [ "$ok" -gt 0 ]; then echo "Generated $ok thumbnails"; else echo "Cache up to date"; fi
    [ "$fail" -gt 0 ] && log "warning: $fail image(s) could not be read by ImageMagick and were skipped"

    # Picker list: <relative name> TAB <thumbnail> TAB <full path>
    local list_tmp i f
    list_tmp=$(mktemp) || die "mktemp failed"
    for i in "${!imgs[@]}"; do
        f="$DATA_DIR/${names[i]}"
        [ -f "$f" ] && printf '%s\t%s\t%s\n' "${imgs[i]#"$BGSEL_WALL_DIR"/}" "$f" "${imgs[i]}"
    done > "$list_tmp"

    # Remove thumbnails whose wallpaper is gone (and any leftovers)
    if [ ${#names[@]} -gt 0 ]; then
        comm -13 \
            <(printf '%s\n' "${names[@]}" | LC_ALL=C sort) \
            <(find "$DATA_DIR" -maxdepth 1 -name '*.jpg' -printf '%f\n' | LC_ALL=C sort)
    else
        find "$DATA_DIR" -maxdepth 1 -name '*.jpg' -printf '%f\n'
    fi | while IFS= read -r stale; do rm -f "$DATA_DIR/$stale"; done

    mv -f "$list_tmp" "$CACHE_LIST"
    printf '%s\n' "$sig" > "$CACHE_SIG"
}

# ---- modes -----------------------------------------------------------------
acquire_lock() {
    # Only one picker at a time (fd 9 is closed for quickshell below)
    mkdir -p "$CACHE_ROOT" || die "cannot create cache directory: $CACHE_ROOT"
    if have flock; then
        exec 9>"$CACHE_ROOT/.lock"
        flock -n 9 || exit 0
    fi
}

require_wall_dir() {
    [ -d "$BGSEL_WALL_DIR" ] || die "wallpaper directory not found: $BGSEL_WALL_DIR (set BGSEL_WALL_DIR in $CONFIG_FILE or use --dir)"
}

run_ui() {
    find_quickshell || die "Quickshell not found (need 'quickshell' or 'qs' in PATH). Run: $PROG --doctor"
    export QS_NO_RELOAD_POPUP=1
    export BGSEL_LIST="$CACHE_LIST"
    export BGSEL_APPLY="$APPLY"
    export BGSEL_DIR="$BGSEL_WALL_DIR"
    # readlink without -f: the exact path apply.sh stored, which matches the
    # list even when the wallpaper folder is itself a symlink.
    BGSEL_CURRENT="$(readlink "$BGSEL_CURRENT_LINK" 2>/dev/null)"
    export BGSEL_CURRENT
    "$QS_BIN" -p "$share/qml" 9>&-
    local rc=$?
    [ $rc -eq 0 ] || notify -u critical "$PROG" "Quickshell exited with an error (code $rc). Run '$PROG' in a terminal to see why."
    exit $rc
}

do_restore() {
    local target
    target="$(readlink "$BGSEL_CURRENT_LINK" 2>/dev/null)"
    [ -n "$target" ] && [ -f "$target" ] || { log "nothing to restore ($BGSEL_CURRENT_LINK)"; exit 1; }
    exec bash "$APPLY" --restore "$target"
}

do_random() {
    require_wall_dir
    local cur pick
    cur="$(readlink "$BGSEL_CURRENT_LINK" 2>/dev/null)"
    pick="$(list_wallpapers | cut -f1 | { grep -vxF -- "$cur" || true; } | shuf -n 1)"
    if [ -z "$pick" ]; then
        pick="$(list_wallpapers | cut -f1 | shuf -n 1)"
    fi
    [ -n "$pick" ] || die "no wallpapers found in $BGSEL_WALL_DIR"
    exec bash "$APPLY" "$pick"
}

doctor() {
    local bad=0 c_ok="" c_bad="" c_off=""
    if [ -t 1 ]; then c_ok=$'\e[32m'; c_bad=$'\e[31m'; c_off=$'\e[0m'; fi
    ok()   { printf '  %s✓%s %s\n' "$c_ok" "$c_off" "$*"; }
    miss() { printf '  %s✗%s %s\n' "$c_bad" "$c_off" "$*"; }
    opt()  { printf '  - %s\n' "$*"; }

    echo "$PROG $VERSION"
    echo
    echo "Required"
    if find_quickshell; then ok "quickshell ($QS_BIN)"; else miss "quickshell — https://quickshell.org"; bad=1; fi
    if find_imagemagick; then ok "ImageMagick ($BGSEL_IM)"; else miss "ImageMagick — install 'imagemagick' (or 'ImageMagick') with your package manager"; bad=1; fi
    for t in find xargs md5sum sort comm mktemp; do
        if have "$t"; then :; else miss "$t (coreutils/findutils)"; bad=1; fi
    done
    if [ "${BASH_VERSINFO[0]}" -gt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 4 ]; }; then
        ok "bash $BASH_VERSION"
    else miss "bash 4.4+ required (found $BASH_VERSION)"; bad=1; fi
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then ok "Wayland session ($WAYLAND_DISPLAY)"
    else miss "WAYLAND_DISPLAY is not set — Quickshell needs a Wayland session"; fi

    echo
    echo "Wallpaper backend (need at least one, or set BGSEL_SET_CMD)"
    local found=0
    for t in awww swww hyprpaper swaybg; do
        if have "$t"; then ok "$t"; found=1; else opt "$t (not installed)"; fi
    done
    if [ -n "$BGSEL_SET_CMD" ]; then ok "custom BGSEL_SET_CMD set"; found=1; fi
    if [ $found -eq 0 ]; then miss "no wallpaper backend found"; bad=1; fi

    echo
    echo "Optional"
    if have matugen; then ok "matugen (dynamic colors)"; else opt "matugen (dynamic colors) — not installed"; fi
    if have wal; then ok "pywal"; else opt "pywal — not installed"; fi
    if have flock; then ok "flock (single-instance lock)"; else opt "flock — not installed, duplicate pickers are not prevented"; fi
    if have notify-send; then ok "notify-send (error popups)"; else opt "notify-send — not installed, errors only go to stderr"; fi
    if have shuf; then ok "shuf (--random)"; else opt "shuf — needed for --random"; fi

    echo
    echo "Configuration"
    if [ -f "$CONFIG_FILE" ]; then ok "config: $CONFIG_FILE"; else opt "config: $CONFIG_FILE (not created, using defaults)"; fi
    if [ -f "$COLORS_FILE" ]; then ok "matugen colors: $COLORS_FILE"; else opt "matugen colors: none (using built-in palette, see README)"; fi
    ok "files: $share"
    if [ -d "$BGSEL_WALL_DIR" ]; then
        local n
        n=$(list_wallpapers | wc -l)
        ok "wallpaper dir: $BGSEL_WALL_DIR ($n images)"
        [ "$n" -eq 0 ] && opt "no images found — add some or set BGSEL_WALL_DIR"
    else
        miss "wallpaper dir does not exist: $BGSEL_WALL_DIR"; bad=1
    fi
    ok "cache: $CACHE_ROOT"
    echo
    if [ $bad -eq 0 ]; then echo "All required checks passed."; else echo "Some required checks failed."; fi
    exit $bad
}

case "$mode" in
    doctor)  doctor ;;
    restore) do_restore ;;
    random)  do_random ;;
    prepare) require_wall_dir; acquire_lock; build_cache ;;
    ui)      require_wall_dir; acquire_lock; build_cache; run_ui ;;
esac
